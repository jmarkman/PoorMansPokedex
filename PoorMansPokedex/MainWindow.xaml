<Window x:Class="PoorMansPokedex.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Poor Man's Pokedex"
        Height="690"
        Width="500"
        MinHeight="650"
        MinWidth="460"
        Background="#741F26"
        WindowStartupLocation="CenterScreen">
    <Border Margin="10"
            Padding="14"
            Background="#C32E38"
            BorderBrush="#54151B"
            BorderThickness="4"
            CornerRadius="24">
    <Grid>
        <Grid.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="#F3F4E8" />
                <Setter Property="Margin" Value="8,3" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="150" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="58" />
            <RowDefinition Height="76" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="8,0">
            <Grid Width="60" Height="60">
                <Ellipse Fill="#35C9D0" Stroke="White" StrokeThickness="5" />
                <Ellipse Width="18"
                         Height="18"
                         Fill="#E84245"
                         Stroke="#F7B7B8"
                         StrokeThickness="1"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Top"
                         Margin="0,-1,-3,0" />
            </Grid>
            <Ellipse Width="24" Height="24" Fill="#F5D247" Margin="6,0" />
            <Ellipse Width="24" Height="24" Fill="#287A3C" Margin="6,0" />
        </StackPanel>

        <Image Grid.Row="1"
               Grid.ColumnSpan="2"
               Source="{Binding OfficialArtwork}"
               AutomationProperties.Name="Official Pokemon artwork"
               MaxWidth="180"
               MaxHeight="140"
               Stretch="Uniform"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Margin="8" />

        <Border Grid.Row="2"
                Grid.RowSpan="10"
                Grid.ColumnSpan="2"
                Background="#173B3E"
                BorderBrush="#62B8AD"
                BorderThickness="2"
                CornerRadius="10"
                Margin="0,3" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Id" />
        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Id}" />
        <TextBlock Grid.Row="3" Grid.Column="0" Text="Name" />
        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Name}" />
        <TextBlock Grid.Row="4" Grid.Column="0" Text="Type" />
        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Types}" />
        <TextBlock Grid.Row="5" Grid.Column="0" Text="Experience provided" />
        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding BaseExperience}" />
        <TextBlock Grid.Row="6" Grid.Column="0" Text="HP" />
        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Hp}" />
        <TextBlock Grid.Row="7" Grid.Column="0" Text="Attack" />
        <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Attack}" />
        <TextBlock Grid.Row="8" Grid.Column="0" Text="Defense" />
        <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding Defense}" />
        <TextBlock Grid.Row="9" Grid.Column="0" Text="Special Attack" />
        <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding SpecialAttack}" />
        <TextBlock Grid.Row="10" Grid.Column="0" Text="Special Defense" />
        <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding SpecialDefense}" />
        <TextBlock Grid.Row="11" Grid.Column="0" Text="Speed" />
        <TextBlock Grid.Row="11" Grid.Column="1" Text="{Binding Speed}" />

        <StackPanel Grid.Row="12"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <TextBox Width="220"
                     Height="30"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <Button Content="Search"
                    Width="110"
                    Height="28"
                    Margin="0,5,0,0"
                    Command="{Binding SearchCommand}" />
        </StackPanel>

        <Grid Grid.Row="13"
              Grid.ColumnSpan="2"
              Margin="8,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="64" />
            </Grid.ColumnDefinitions>
            <Ellipse Grid.Column="0"
                     Width="34"
                     Height="34"
                     Fill="#111111"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top" />
            <Grid Grid.Column="1"
                  Width="138"
                  Height="42"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">
                <Rectangle Fill="#185034" />
                <Rectangle Width="112"
                           Height="7"
                           Fill="#4A9463"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           Margin="0,8,0,0" />
                <Rectangle Width="112"
                           Height="7"
                           Fill="#4A9463"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Bottom"
                           Margin="0,0,0,8" />
            </Grid>
            <Grid Grid.Column="2"
                  Width="56"
                  Height="56"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center">
                <Rectangle Width="56" Height="18" Fill="#252B2B" />
                <Rectangle Width="18" Height="56" Fill="#252B2B" />
                <Ellipse Width="12" Height="12" Fill="#5E6868" />
            </Grid>
        </Grid>
    </Grid>
    </Border>
</Window>
